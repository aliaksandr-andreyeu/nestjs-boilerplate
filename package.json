{
  "name": "nestjs-boilerplate",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS microservices boilerplate",
  "keywords": [],
  "author": {
    "name": "Aliaksandr Andreyeu",
    "email": "andreyeu.aliaksandr@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start:gateway": "nest start gateway",
    "start:auth": "nest start auth-service",
    "start:events": "nest start events-service",
    "test": "vitest",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "prisma:generate": "prisma generate --schema=./prisma/auth/schema.prisma && prisma generate --schema=./prisma/events/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/auth/schema.prisma && prisma migrate dev --schema=./prisma/events/schema.prisma",
    "format": "prettier --write \"./**/*.{js,jsx,cjs,mjs,ts,tsx,json}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod:gateway": "node dist/apps/gateway/src/main",
    "start:prod:auth": "node dist/apps/auth-service/src/main",
    "start:prod:events": "node dist/apps/events-service/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "postinstall": "npx typesync"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.23",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.23",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.23",
    "@nestjs/platform-ws": "^11.1.23",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11.1.23",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.106.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nats": "^2.29.3",
    "nest-winston": "^1.10.2",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.23",
    "@types/bcrypt": "~6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/source-map-support": "~0.5.10",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "typesync": "^0.14.3",
    "vitest": "^4.1.7"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
