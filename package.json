{
  "name": "nestjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS Microservices Boilerplate with Postgres, Swagger, NATS, Redis",
  "keywords": [],
  "author": {
    "name": "Aliaksandr Andreyeu",
    "email": "andreyeu.aliaksandr@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/aliaksandr-andreyeu/nestjs-boilerplate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliaksandr-andreyeu/nestjs-boilerplate.git"
  },
  "scripts": {
    "postinstall": "npm run prisma:generate && npx typesync",
    "prepare": "husky",
    "precommit": "lint-staged",
    "format": "prettier --write \"./**/*.{js,jsx,cjs,mjs,ts,tsx,json}\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "build": "nest build shared && nest build gateway && nest build auth-service && nest build events-service && tsc-alias -p tsconfig.build.json",
    "build:shared": "nest build shared",
    "build:gateway": "nest build shared && nest build gateway && tsc-alias -p tsconfig.build.json && node -e \"require('node:fs').accessSync('dist/apps/gateway/main.js')\"",
    "build:auth": "nest build shared && nest build auth-service && tsc-alias -p tsconfig.build.json && node -e \"require('node:fs').accessSync('dist/apps/auth-service/main.js')\"",
    "build:events": "nest build shared && nest build events-service && tsc-alias -p tsconfig.build.json && node -e \"require('node:fs').accessSync('dist/apps/events-service/main.js')\"",
    "start:gateway": "nest start gateway",
    "start:gateway:dev": "nest start gateway --watch",
    "start:gateway:debug": "nest start gateway --debug --watch",
    "start:gateway:prod": "npm run build:gateway && node dist/apps/gateway/main.js",
    "start:auth": "nest start auth-service",
    "start:auth:dev": "nest start auth-service --watch",
    "start:auth:debug": "nest start auth-service --debug --watch",
    "start:auth:prod": "npm run build:auth && node dist/apps/auth-service/main.js",
    "start:events": "nest start events-service",
    "start:events:dev": "nest start events-service --watch",
    "start:events:debug": "nest start events-service --debug",
    "start:events:prod": "npm run build:events && node dist/apps/events-service/main.js",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:migrate:auth": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:events": "prisma migrate dev --config prisma.config.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:coverage": "vitest run --config vitest.e2e.config.ts --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^9.1.3",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.23",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/platform-ws": "^11.1.23",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11.1.24",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "keyv": "^5.5.5",
    "nats": "^2.29.3",
    "nest-winston": "^1.10.2",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@types/bcrypt": "~6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/source-map-support": "~0.5.10",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "nats-cli": "^1.2.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.6.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "typesync": "^0.14.3",
    "vitest": "^4.1.7"
  }
}
