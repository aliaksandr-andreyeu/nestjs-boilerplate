{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json",
        "deleteOutDir": false
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json",
        "deleteOutDir": false
      }
    },
    "events-service": {
      "type": "application",
      "root": "apps/events-service",
      "entryFile": "main",
      "sourceRoot": "apps/events-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/events-service/tsconfig.app.json",
        "deleteOutDir": false
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json",
        "deleteOutDir": false
      }
    }
  },
  "compilerOptions": {
    "deleteOutDir": false
  }
}
