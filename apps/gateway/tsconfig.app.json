{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "../../dist/apps/gateway",
    "rootDir": "src",
    "paths": {
      "@shared": ["../../dist/libs/shared/index"],
      "@shared/*": ["../../dist/libs/shared/src/*"],
      "@gateway/*": ["./src/*"],
      "@prisma/app-client": ["../../node_modules/@prisma/app-client"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.e2e-spec.ts"]
}
